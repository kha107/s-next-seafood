@model SNextSeafood.Web.Models.ProductDetailViewModel
@{
    ViewData["Title"] = Model.Product.Name;
    var now = DateTime.UtcNow;
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Trang Chủ</a></li>
        <li class="breadcrumb-item"><a asp-action="Index" asp-route-categoryId="@Model.Product.CategoryId" class="text-decoration-none">@Model.Product.Category?.Name</a></li>
        <li class="breadcrumb-item active">@Model.Product.Name</li>
    </ol>
</nav>

<div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
    <div class="row g-4">
        <div class="col-lg-5">
            <div class="rounded-4 overflow-hidden border position-relative" style="height: 380px;">
                <img src="@Model.Product.ImageUrl" alt="@Model.Product.Name" class="w-100 h-100 object-fit-cover" />
                <div class="position-absolute top-0 start-0 m-3 d-flex flex-column gap-2">
                    <span class="badge-cold-chain fs-6">
                        <i class="bi bi-thermometer-snow me-1"></i>@Model.Product.StorageCondition
                    </span>
                    <span class="badge bg-dark bg-opacity-75 text-white px-3 py-2">
                        <i class="bi bi-box-seam text-info me-1"></i>@Model.Product.PackagingMethod
                    </span>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25">
                    <i class="bi bi-globe-asia-australia me-1"></i>Xuất xứ: @Model.Product.Origin
                </span>
                <span class="badge bg-info bg-opacity-10 text-dark border">
                    SKU: <code>@Model.SelectedVariant.Sku</code>
                </span>
                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                    <i class="bi bi-check2-circle me-1"></i>Tồn kho khả dụng: <strong>@Model.FefoPreview.TotalAvailableQuantity</strong> đơn vị
                </span>
            </div>

            <h2 class="fw-bold mb-2">@Model.Product.Name</h2>
            <p class="text-muted mb-3">@Model.Product.Description</p>

            <!-- Price Box -->
            <div class="p-3 rounded-4 bg-light border mb-3 d-flex flex-wrap align-items-baseline gap-3">
                <span class="fs-2 fw-bold text-danger">@Model.SelectedVariant.Price.ToString("N0") đ</span>
                @if (Model.SelectedVariant.OriginalPrice.HasValue)
                {
                    <span class="text-decoration-line-through text-muted fs-5">@Model.SelectedVariant.OriginalPrice.Value.ToString("N0") đ</span>
                }
                <span class="badge bg-warning text-dark ms-auto">
                    Quy cách: @Model.SelectedVariant.PackagingSpec
                </span>
            </div>

            <!-- Variant Switcher -->
            <div class="mb-3">
                <label class="form-label fw-semibold small text-uppercase text-secondary">Chọn quy cách đóng gói:</label>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var v in Model.Product.Variants.OrderBy(x => x.WeightGrams))
                    {
                        var vAvail = v.WarehouseBatches
                            .Where(b => b.ExpiryDate > now && (b.RemainingQuantity - b.ReservedQuantity) > 0)
                            .Sum(b => Math.Max(0, b.RemainingQuantity - b.ReservedQuantity));

                        <a asp-action="Details"
                           asp-route-slug="@Model.Product.Slug"
                           asp-route-variantId="@v.VariantId"
                           class="btn @(v.VariantId == Model.SelectedVariant.VariantId ? "btn-ocean" : "btn-outline-secondary") rounded-3 px-3 py-2">
                            <div class="fw-bold">@v.PackagingSpec (@v.Price.ToString("N0")đ)</div>
                            <div class="small opacity-75">Mã: @v.Sku &bull; Khả dụng: @vAvail</div>
                        </a>
                    }
                </div>
            </div>

            <!-- Add to Cart Form -->
            <form asp-controller="Cart" asp-action="Add" method="post" class="row g-2 align-items-end mb-4">
                <input type="hidden" name="variantId" value="@Model.SelectedVariant.VariantId" />
                <div class="col-sm-4">
                    <label class="form-label fw-semibold small">Số lượng đặt mua:</label>
                    <input type="number" name="quantity" value="2" min="1" max="@Math.Max(1, Model.FefoPreview.TotalAvailableQuantity)" class="form-control form-control-lg fw-bold text-center" />
                </div>
                <div class="col-sm-8">
                    <button type="submit" class="btn btn-coral btn-lg w-100">
                        <i class="bi bi-cart-check-fill me-2"></i>Thêm Vào Giỏ Hàng
                    </button>
                </div>
            </form>

            <!-- Customer-safe Freshness & Cold-Chain Assurance Box -->
            @{
                var earliestBatch = Model.SelectedVariant.WarehouseBatches
                    .Where(b => b.ExpiryDate > now && (b.RemainingQuantity - b.ReservedQuantity) > 0)
                    .OrderBy(b => b.ExpiryDate)
                    .ThenBy(b => b.ImportDate)
                    .FirstOrDefault();
            }
            <div class="border rounded-4 p-3 bg-info bg-opacity-10 border-info border-opacity-25">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-patch-check-fill text-primary me-1"></i>Cam Kết Chất Lượng &amp; Chuỗi Lạnh S-NEXT
                    </h6>
                    <span class="badge bg-primary">Kiểm soát hạn dùng chặt chẽ</span>
                </div>
                <div class="row g-2 small">
                    <div class="col-sm-6">
                        <div class="p-2 rounded-3 bg-white border">
                            <div class="text-muted">Lô hàng xuất hiện tại:</div>
                            @if (earliestBatch is not null)
                            {
                                <div class="fw-bold text-dark">
                                    HSD: @earliestBatch.ExpiryDate.ToString("dd/MM/yyyy")
                                    <span class="badge @(earliestBatch.DaysUntilExpiry <= 15 ? "bg-warning text-dark" : "bg-success") ms-1">
                                        Còn @earliestBatch.DaysUntilExpiry ngày
                                    </span>
                                </div>
                            }
                            else
                            {
                                <div class="fw-bold text-danger">Đang nhập thêm lô mới</div>
                            }
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-2 rounded-3 bg-white border">
                            <div class="text-muted">Bảo quản &amp; Giao nhận:</div>
                            <div class="fw-bold text-dark">
                                <i class="bi bi-snow2 text-info me-1"></i>@Model.Product.StorageCondition &bull; Giao xe lạnh nội thành
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
