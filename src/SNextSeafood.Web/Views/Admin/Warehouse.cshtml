@model SNextSeafood.Web.Models.AdminWarehouseViewModel
@using SNextSeafood.Domain.Enums
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản Lý Tồn Kho Lạnh & Lô Hàng Theo Hạn Sử Dụng";
}

<!-- Admin Navigation Sub-bar -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <span class="badge bg-info text-dark mb-1"><i class="bi bi-boxes me-1"></i>QUẢN LÝ KHO LẠNH THEO LÔ HÀNG</span>
        <h3 class="fw-bold mb-0">Quản Lý Tồn Kho &amp; Hạn Sử Dụng Từng Lô Hàng</h3>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a href="/Admin/Warehouse/Import" class="btn btn-coral rounded-pill px-3">
            <i class="bi bi-plus-circle me-1"></i>Lập Phiếu Nhập Lô Mới
        </a>
        <a href="/Admin/Dashboard" class="btn btn-ocean rounded-pill px-3">
            <i class="bi bi-bar-chart-line me-1"></i>Tổng Quan &amp; Báo Cáo
        </a>
        <a href="/Admin/Dashboard/ExportInventoryExcel" class="btn btn-outline-success rounded-pill px-3">
            <i class="bi bi-file-earmark-excel me-1"></i>Xuất Báo Cáo Tồn Kho (.xlsx)
        </a>
    </div>
</div>

<!-- KPI Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="kpi-card p-3 border-start border-4 border-primary">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="small text-muted text-uppercase fw-semibold">Tồn Thực Tế / Khả Dụng</div>
                    <div class="fs-4 fw-bold text-dark">
                        @Model.Summary.TotalRemainingUnits <span class="text-muted fs-6">/</span>
                        <span class="text-success">@Model.Summary.TotalAvailableUnits</span>
                    </div>
                    <div class="small text-muted">Đang giữ cho đơn chờ: <strong class="text-warning">@Model.Summary.TotalReservedUnits</strong> gói</div>
                </div>
                <div class="fs-2 text-primary opacity-75"><i class="bi bi-box-seam-fill"></i></div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="kpi-card p-3 border-start border-4 border-warning" style="background-color: #fffdf5;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="small text-warning-emphasis text-uppercase fw-bold">Cảnh Báo Lô Cận Hạn (&lt;15 ngày)</div>
                    <div class="fs-3 fw-bold text-warning-emphasis">@Model.Summary.NearExpiryBatchCount lô</div>
                    <div class="small text-muted">Tự động ưu tiên xuất trước</div>
                </div>
                <div class="fs-2 text-warning"><i class="bi bi-exclamation-triangle-fill"></i></div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="kpi-card p-3 border-start border-4 border-danger">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="small text-danger text-uppercase fw-bold">Lô Quá Hạn / Sắp Hết Hàng</div>
                    <div class="fs-4 fw-bold text-danger">
                        @Model.Summary.ExpiredBatchCount quá hạn &bull; @Model.Summary.LowStockBatchCount sắp hết
                    </div>
                    <div class="small text-muted">Cần xuất hủy hoặc nhập bổ sung</div>
                </div>
                <div class="fs-2 text-danger opacity-75"><i class="bi bi-thermometer-high"></i></div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="kpi-card p-3 border-start border-4 border-success">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="small text-muted text-uppercase fw-semibold">Tổng Giá Trị Tồn Kho (Giá vốn)</div>
                    <div class="fs-4 fw-bold text-success">@Model.Summary.TotalInventoryCostValue.ToString("N0") đ</div>
                    <div class="small text-muted">Trên tổng số @Model.Summary.TotalActiveBatches lô đang lưu kho</div>
                </div>
                <div class="fs-2 text-success opacity-75"><i class="bi bi-cash-stack"></i></div>
            </div>
        </div>
    </div>
</div>

<!-- Filter Tabs -->
<div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="d-flex flex-wrap gap-2">
            <a href="/Admin/Warehouse?filter=all"
               class="btn @(Model.ActiveFilter == "all" ? "btn-ocean" : "btn-outline-secondary") rounded-pill btn-sm px-3">
                <i class="bi bi-layers me-1"></i>Tất Cả Các Lô (@Model.Batches.Count)
            </a>
            <a href="/Admin/Warehouse?filter=nearexpiry"
               class="btn @(Model.ActiveFilter == "nearexpiry" ? "btn-warning fw-bold text-dark" : "btn-outline-warning text-dark") rounded-pill btn-sm px-3">
                <i class="bi bi-clock-history me-1"></i>Sắp Hết Hạn (&lt; 15 ngày) (@Model.Summary.NearExpiryBatchCount)
            </a>
            <a href="/Admin/Warehouse?filter=expired"
               class="btn @(Model.ActiveFilter == "expired" ? "btn-danger" : "btn-outline-danger") rounded-pill btn-sm px-3">
                <i class="bi bi-x-octagon me-1"></i>Đã Hết Hạn (@Model.Summary.ExpiredBatchCount)
            </a>
            <a href="/Admin/Warehouse?filter=lowstock"
               class="btn @(Model.ActiveFilter == "lowstock" ? "btn-coral" : "btn-outline-secondary") rounded-pill btn-sm px-3">
                <i class="bi bi-arrow-down-circle me-1"></i>Sắp Hết Tồn Kho (@Model.Summary.LowStockBatchCount)
            </a>
            <a href="/Admin/Warehouse?filter=reserved"
               class="btn @(Model.ActiveFilter == "reserved" ? "btn-primary" : "btn-outline-primary") rounded-pill btn-sm px-3">
                <i class="bi bi-hourglass-split me-1"></i>Đang Giữ Chỗ Chờ Thanh Toán
            </a>
        </div>
        <div class="small text-muted">
            <i class="bi bi-sort-numeric-down text-primary me-1"></i>Ưu tiên hiển thị theo hạn sử dụng gần nhất
        </div>
    </div>
</div>

<!-- Main Batches Table -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="table-responsive">
        <table class="table table-hover table-bordered mb-0 align-middle table-wms small">
            <thead>
                <tr>
                    <th>Mã Lô Hàng</th>
                    <th>Sản Phẩm &amp; Quy Cách</th>
                    <th>Nhà Cung Cấp &amp; Vị Trí Kệ</th>
                    <th>Ngày SX</th>
                    <th>Hạn Sử Dụng</th>
                    <th class="text-center">Ngày Còn Lại</th>
                    <th class="text-end">Giá Vốn</th>
                    <th class="text-center">Tồn Thực Tế</th>
                    <th class="text-center">Đang Giữ</th>
                    <th class="text-center">Khả Dụng</th>
                    <th class="text-center">Tình Trạng</th>
                    <th class="text-center">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var batch in Model.Batches)
                {
                    var isNearExpiry = batch.DaysUntilExpiry > 0 && batch.DaysUntilExpiry <= 15 && batch.RemainingQuantity > 0;
                    var isExpired = batch.DaysUntilExpiry <= 0 || batch.BatchStatus == BatchStatus.Expired;
                    var rowClass = isExpired ? "row-expired" : (isNearExpiry ? "row-near-expiry" : "");

                    <tr class="@rowClass">
                        <td>
                            <strong class="text-primary">@batch.BatchCode</strong>
                            <div class="text-muted" style="font-size: 0.72rem;">Nhập: @batch.ImportDate.ToString("dd/MM/yyyy")</div>
                        </td>
                        <td>
                            <div class="fw-bold text-dark">@batch.ProductVariant?.Product?.Name</div>
                            <div class="text-muted">
                                <span class="badge bg-light text-dark border">@batch.ProductVariant?.PackagingSpec</span>
                                <span class="small">@batch.ProductVariant?.Sku</span>
                            </div>
                        </td>
                        <td>
                            <div class="fw-semibold">@batch.Supplier?.Name</div>
                            <span class="badge bg-dark bg-opacity-75"><i class="bi bi-snow me-1"></i>@batch.StorageRack</span>
                        </td>
                        <td>@batch.ManufactureDate.ToString("dd/MM/yyyy")</td>
                        <td class="fw-bold @(isExpired ? "text-danger" : isNearExpiry ? "text-warning-emphasis" : "text-dark")">
                            @batch.ExpiryDate.ToString("dd/MM/yyyy")
                        </td>
                        <td class="text-center">
                            @if (batch.DaysUntilExpiry <= 0)
                            {
                                <span class="badge badge-fefo-expired">Quá hạn @Math.Abs(batch.DaysUntilExpiry) ngày</span>
                            }
                            else if (batch.DaysUntilExpiry <= 15)
                            {
                                <span class="badge badge-fefo-near">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>Còn @batch.DaysUntilExpiry ngày
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-fefo-active">Còn @batch.DaysUntilExpiry ngày</span>
                            }
                        </td>
                        <td class="text-end">@batch.ImportUnitPrice.ToString("N0")đ</td>
                        <td class="text-center fw-bold fs-6">@batch.RemainingQuantity <span class="text-muted fw-normal">/@batch.InitialQuantity</span></td>
                        <td class="text-center">
                            @if (batch.ReservedQuantity > 0)
                            {
                                <span class="badge bg-warning text-dark fs-6 px-2">
                                    <i class="bi bi-lock-fill me-1"></i>@batch.ReservedQuantity
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">0</span>
                            }
                        </td>
                        <td class="text-center">
                            <span class="fw-bold fs-6 @(batch.AvailableQuantity > 0 ? "text-success" : "text-danger")">
                                @batch.AvailableQuantity
                            </span>
                        </td>
                        <td class="text-center">
                            @switch (batch.BatchStatus)
                            {
                                case BatchStatus.NearExpiry:
                                    <span class="badge badge-fefo-near">Sắp hết hạn</span>
                                    break;
                                case BatchStatus.Expired:
                                    <span class="badge badge-fefo-expired">Đã quá hạn</span>
                                    break;
                                case BatchStatus.LowStock:
                                    <span class="badge badge-fefo-low">Sắp hết hàng</span>
                                    break;
                                case BatchStatus.Depleted:
                                    <span class="badge bg-secondary">Đã xuất hết</span>
                                    break;
                                default:
                                    <span class="badge badge-fefo-active">Đạt chuẩn</span>
                                    break;
                            }
                        </td>
                        <td class="text-center">
                            @if (batch.RemainingQuantity - batch.ReservedQuantity > 0 && (isExpired || isNearExpiry))
                            {
                                <form asp-action="DiscardBatch" method="post" class="d-inline"
                                      onsubmit="return confirm('Xác nhận lập phiếu xuất hủy cho lô @batch.BatchCode?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="batchId" value="@batch.BatchId" />
                                    <input type="hidden" name="quantityToDiscard" value="@(batch.RemainingQuantity - batch.ReservedQuantity)" />
                                    <input type="hidden" name="reason" value="Xuất hủy lô @(isExpired ? "đã quá hạn sử dụng" : "cận hạn không đạt chuẩn cảm quan") theo quy trình kiểm soát chất lượng S-NEXT" />
                                    <button type="submit" class="btn btn-sm btn-danger rounded-pill px-2" title="Lập phiếu xuất hủy">
                                        <i class="bi bi-trash3-fill me-1"></i>Xuất Hủy
                                    </button>
                                </form>
                            }
                            else
                            {
                                <a href="/Admin/Warehouse/Import?variantId=@batch.ProductVariantId" class="btn btn-sm btn-outline-primary rounded-pill px-2">
                                    <i class="bi bi-plus-lg"></i> Nhập Thêm
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
