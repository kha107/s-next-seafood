@using SNextSeafood.Web.Helpers
@{
    var cartItems = SessionCartHelper.GetCart(Context.Session);
    var cartCount = cartItems.Sum(i => i.Quantity);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - S-NEXT Seafood (Thủy Hải Sản Cấp Đông Chuẩn IQF -18°C)</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Top Info Bar (Chỉ hiển thị thông tin doanh nghiệp & chuỗi lạnh dành cho khách hàng) -->
    <div class="bg-dark text-light py-1 small border-bottom border-secondary border-opacity-25">
        <div class="container d-flex flex-wrap justify-content-between align-items-center">
            <div>
                <i class="bi bi-building-check text-info me-1"></i>
                <strong>CÔNG TY TNHH S-NEXT</strong> (MST: <span class="text-warning fw-semibold">0313778856</span>)
                <span class="mx-2 text-secondary">|</span>
                <i class="bi bi-geo-alt-fill text-danger me-1"></i>266/78/47 Tô Hiến Thành, P. Hòa Hưng, TP. Hồ Chí Minh
            </div>
            <div class="d-flex align-items-center gap-3">
                <span><i class="bi bi-snow2 text-info me-1"></i>Giao Hàng Xe Lạnh -18°C Toàn TP.HCM</span>
                <span><i class="bi bi-telephone-fill text-warning me-1"></i>1900 6886</span>
            </div>
        </div>
    </div>

    <!-- Main Customer Navbar (Tuyệt đối không hiển thị nút Admin hay Swagger) -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark navbar-snext py-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold fs-4" asp-controller="Home" asp-action="Index">
                    <span class="p-2 rounded-3 bg-info bg-opacity-25 text-info d-inline-flex align-items-center justify-content-center">
                        <i class="bi bi-tsunami"></i>
                    </span>
                    <div>
                        <span class="text-white">S-NEXT</span> <span style="color:#ff6b35;">SEAFOOD</span>
                        <div class="text-info fw-normal" style="font-size: 0.68rem; letter-spacing: 0.05em;">THỦY HẢI SẢN CẤP ĐÔNG IQF -18°C</div>
                    </div>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#snextNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="snextNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-1">
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-pill text-white fw-medium" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-shop me-1"></i>Sản Phẩm Hải Sản
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-pill text-white fw-medium" href="/Order/Track">
                                <i class="bi bi-search me-1"></i>Tra Cứu Đơn Hàng
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        <a asp-controller="Cart" asp-action="Index" class="btn btn-coral rounded-pill px-4 position-relative">
                            <i class="bi bi-cart3 me-1"></i>Giỏ Hàng &amp; Thanh Toán
                            <span class="badge rounded-pill bg-white text-dark ms-1">@cartCount</span>
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4 flex-grow-1">
        @if (TempData["SuccessMessage"] is string successMsg)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3 d-flex align-items-center" role="alert">
                <i class="bi bi-check-circle-fill fs-5 me-2 text-success"></i>
                <div>@successMsg</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] is string errorMsg)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 rounded-3 d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-octagon-fill fs-5 me-2 text-danger"></i>
                <div>@errorMsg</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-snext py-4 mt-5">
        <div class="container">
            <div class="row g-4 align-items-center">
                <div class="col-md-7">
                    <h6 class="text-white fw-bold mb-1">
                        <i class="bi bi-tsunami text-info me-1"></i>S-NEXT SEAFOOD &mdash; CÔNG TY TNHH S-NEXT
                    </h6>
                    <p class="small mb-1">
                        Mã số thuế: <strong class="text-warning">0313778856</strong> | Địa chỉ: <strong>266/78/47 Tô Hiến Thành, Phường Hòa Hưng, TP. Hồ Chí Minh</strong>
                    </p>
                    <p class="small text-secondary mb-0">
                        Nền tảng thương mại điện tử ngành hàng thủy hải sản được Công ty TNHH S-NEXT phát triển và phân phối cho đối tác kinh doanh hải sản.
                    </p>
                </div>
                <div class="col-md-5 text-md-end small">
                    <div class="mb-2 text-white-50">
                        <i class="bi bi-shield-check text-success me-1"></i>Thanh toán an toàn qua VNPay, Ví MoMo &amp; COD Nội thành TP.HCM
                    </div>
                    <div class="text-secondary">
                        &copy; 2026 Công ty TNHH S-NEXT &mdash; Bản quyền đã được bảo hộ.
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
