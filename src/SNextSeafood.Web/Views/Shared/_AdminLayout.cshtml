@{
    var adminName = User.Identity?.Name ?? "Quản trị viên S-NEXT";
    var currentPath = Context.Request.Path.Value?.ToLowerInvariant() ?? string.Empty;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Trị Hệ Thống S-NEXT Seafood</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Admin Top Header -->
    <div class="bg-dark text-light py-1 small border-bottom border-info border-opacity-25">
        <div class="container d-flex flex-wrap justify-content-between align-items-center">
            <div>
                <i class="bi bi-shield-lock-fill text-warning me-1"></i>
                <strong>CÔNG TY TNHH S-NEXT</strong> &bull; Hệ Thống Quản Trị Kinh Doanh &amp; Kho Lạnh
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="text-info"><i class="bi bi-person-circle me-1"></i>@adminName</span>
                <a href="/" class="text-white-50 text-decoration-none">
                    <i class="bi bi-shop me-1"></i>Xem Trang Khách Hàng
                </a>
            </div>
        </div>
    </div>

    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark navbar-snext py-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold fs-5" href="/Admin/Dashboard">
                    <span class="p-2 rounded-3 bg-warning bg-opacity-25 text-warning d-inline-flex align-items-center justify-content-center">
                        <i class="bi bi-shield-check"></i>
                    </span>
                    <div>
                        <span class="text-white">S-NEXT</span> <span style="color:#ff6b35;">QUẢN TRỊ</span>
                        <div class="text-info fw-normal" style="font-size: 0.68rem; letter-spacing: 0.05em;">QUẢN LÝ KHO LẠNH &amp; ĐƠN HÀNG</div>
                    </div>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="adminNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-pill @(currentPath.StartsWith("/admin/dashboard") ? "bg-white bg-opacity-25 text-white fw-semibold" : "text-white-50")"
                               href="/Admin/Dashboard">
                                <i class="bi bi-bar-chart-line-fill me-1"></i>Tổng Quan &amp; Báo Cáo
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-pill @(currentPath == "/admin/warehouse" ? "bg-white bg-opacity-25 text-white fw-semibold" : "text-white-50")"
                               href="/Admin/Warehouse">
                                <i class="bi bi-boxes me-1"></i>Quản Lý Kho Lô
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-pill @(currentPath.StartsWith("/admin/warehouse/import") ? "bg-white bg-opacity-25 text-white fw-semibold" : "text-white-50")"
                               href="/Admin/Warehouse/Import">
                                <i class="bi bi-journal-plus me-1"></i>Nhập Kho &amp; Ảnh Sản Phẩm
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-pill @(currentPath.StartsWith("/admin/orders") ? "bg-white bg-opacity-25 text-white fw-semibold" : "text-white-50")"
                               href="/Admin/Orders">
                                <i class="bi bi-receipt-cutoff me-1"></i>Đơn Hàng &amp; Hóa Đơn
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        <a href="/" class="btn btn-outline-light btn-sm rounded-pill px-3">
                            <i class="bi bi-house-door me-1"></i>Cửa Hàng
                        </a>
                        <form action="/snext-portal/logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-sm rounded-pill px-3">
                                <i class="bi bi-box-arrow-right me-1"></i>Đăng Xuất
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4 flex-grow-1">
        @if (TempData["SuccessMessage"] is string successMsg)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3 d-flex align-items-center" role="alert">
                <i class="bi bi-check-circle-fill fs-5 me-2 text-success"></i>
                <div>@successMsg</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] is string errorMsg)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 rounded-3 d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-octagon-fill fs-5 me-2 text-danger"></i>
                <div>@errorMsg</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-snext py-3 mt-5">
        <div class="container d-flex flex-wrap justify-content-between align-items-center small">
            <div>
                <strong class="text-white">CÔNG TY TNHH S-NEXT</strong> (MST: 0313778856) &mdash; Hệ Thống Quản Trị Kho Lạnh &amp; Thương Mại Điện Tử
            </div>
            <div class="text-secondary">Khu vực quản trị nội bộ &copy; 2026</div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
