@{
    Layout = null;
    var returnUrl = ViewData["ReturnUrl"] as string;
    var errorMessage = ViewData["ErrorMessage"] as string;
    var username = ViewData["Username"] as string;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng Nhập Quản Trị Nội Bộ - S-NEXT Seafood</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        body {
            font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
            background: linear-gradient(135deg, #071e3d 0%, #0b4f6c 60%, #0a3656 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
        }
        .login-card {
            max-width: 440px;
            width: 100%;
            border-radius: 1.25rem;
            border: 1px solid rgba(255, 255, 255, 0.15);
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
            overflow: hidden;
            background: #ffffff;
        }
        .login-header {
            background: #071e3d;
            color: #fff;
            padding: 2rem 2rem 1.75rem;
            text-align: center;
        }
        .btn-coral {
            background: linear-gradient(135deg, #ff6b35 0%, #e8531d 100%);
            color: #fff;
            border: none;
            font-weight: 600;
        }
        .btn-coral:hover {
            background: linear-gradient(135deg, #e8531d 0%, #c93f0e 100%);
            color: #fff;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="login-header">
            <div class="d-inline-flex align-items-center justify-content-center rounded-4 bg-info bg-opacity-25 text-info mb-3" style="width: 60px; height: 60px;">
                <i class="bi bi-shield-lock-fill fs-2"></i>
            </div>
            <h4 class="fw-bold mb-1">CỔNG QUẢN TRỊ NỘI BỘ</h4>
            <div class="small text-info fw-semibold">S-NEXT SEAFOOD &bull; QUẢN LÝ KHO &amp; KINH DOANH</div>
            <div class="text-white-50 mt-1" style="font-size: 0.78rem;">CÔNG TY TNHH S-NEXT (MST: 0313778856)</div>
        </div>

        <div class="p-4">
            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger d-flex align-items-center gap-2 small rounded-3 py-2" role="alert">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <div>@errorMessage</div>
                </div>
            }

            <form action="/snext-portal/login" method="post">
                @Html.AntiForgeryToken()
                @if (!string.IsNullOrWhiteSpace(returnUrl))
                {
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                }

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary">Tài khoản Quản trị viên</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-person-badge text-primary"></i></span>
                        <input type="text" name="username" value="@username" class="form-control" placeholder="admin@snextseafood.vn" required autofocus />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-semibold text-secondary">Mật khẩu bảo mật</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-key-fill text-primary"></i></span>
                        <input type="password" name="password" class="form-control" placeholder="Nhập mật khẩu quản trị..." required />
                    </div>
                </div>

                <button type="submit" class="btn btn-coral btn-lg w-100 rounded-3 mb-3">
                    <i class="bi bi-box-arrow-in-right me-1"></i>Đăng Nhập Hệ Thống Quản Trị
                </button>
            </form>

            <div class="text-center border-top pt-3 mt-2">
                <a href="/" class="small text-decoration-none text-muted">
                    <i class="bi bi-arrow-left me-1"></i>Quay lại Trang chủ Khách hàng
                </a>
            </div>
        </div>
    </div>
</body>
</html>
