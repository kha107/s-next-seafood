# ==============================================================================
# S-NEXT Seafood - Environment Variables Template (.env.example)
# Sao chép file này thành ".env" ở thư mục gốc và điền giá trị thực tế của bạn.
# Lưu ý: Dùng dấu gạch dưới kép (__) để map vào cấu hình phân cấp ASP.NET Core.
# ==============================================================================

# 1. Môi trường chạy ứng dụng
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5188

# 2. Chuỗi kết nối SQL Server (LocalDB hoặc SQL Server Express/Docker)
ConnectionStrings__DefaultConnection=Server=(localdb)\mssqllocaldb;Database=SNextSeafoodDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True

# 3. Tài khoản Quản trị viên nội bộ (/snext-portal/login)
AdminAuth__Username=admin@snextseafood.vn
AdminAuth__AltUsername=admin
AdminAuth__Password=CHANGE_ME_STRONG_PASSWORD
AdminAuth__DisplayName=Trần Minh Tâm (Quản trị viên S-NEXT)
AdminAuth__PortalPath=/snext-portal/login

# 4. Cấu hình Cổng thanh toán VNPay Sandbox (HMAC-SHA512)
VnPay__TmnCode=YOUR_VNPAY_TMN_CODE
VnPay__HashSecret=YOUR_VNPAY_HASH_SECRET_KEY
VnPay__BaseUrl=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VnPay__ReturnUrl=/Payment/PaymentCallback
VnPay__UseLocalSimulator=true

# 5. Cấu hình Ví điện tử MoMo / VietQR
MoMo__PartnerCode=YOUR_MOMO_PARTNER_CODE
MoMo__AccessKey=YOUR_MOMO_ACCESS_KEY
MoMo__SecretKey=YOUR_MOMO_SECRET_KEY
MoMo__ReturnUrl=/Payment/PaymentCallback

# 6. Thông tin Doanh nghiệp hiển thị trên Hóa đơn & Báo cáo
CompanyInfo__CompanyName=CÔNG TY TNHH S-NEXT
CompanyInfo__BrandName=S-NEXT Seafood & Cold Chain
CompanyInfo__TaxCode=0313778856
CompanyInfo__Address=266/78/47 Tô Hiến Thành, Phường Hòa Hưng, TP. Hồ Chí Minh
CompanyInfo__Hotline=1900 6886 - (028) 3868 7886
CompanyInfo__Email=contact@snextseafood.vn
